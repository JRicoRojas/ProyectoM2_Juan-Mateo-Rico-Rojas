{
  "name": "proyectom2_mateo_rico",
  "version": "1.0.0",
  "description": "proyecto para uso de APIs node.js express y backend, app para authors y post",
  "homepage": "https://github.com/JRicoRojas/ProyectoM2_Juan-Mateo-Rico-Rojas#readme",
  "bugs": {
    "url": "https://github.com/JRicoRojas/ProyectoM2_Juan-Mateo-Rico-Rojas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JRicoRojas/ProyectoM2_Juan-Mateo-Rico-Rojas.git"
  },
  "license": "ISC",
  "author": "Mateo Rico",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file=.env server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:init": "node --env-file-if-exists=.env db/init.js",
    "db:schema": "node --env-file-if-exists=.env db/init.js --no-seed"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
