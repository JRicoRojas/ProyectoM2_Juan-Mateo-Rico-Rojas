# Cadena de conexion a PostgreSQL (obligatoria)
# Local:   postgresql://USUARIO:PASSWORD@localhost:5432/NOMBRE_BASE
# Railway: usar la referencia ${{Postgres.DATABASE_URL}} en las variables del servicio
DATABASE_URL=postgresql://USUARIO:PASSWORD@localhost:5432/NOMBRE_BASE

# Puerto del servidor (opcional, Railway lo define solo). Por defecto: 3000
PORT=3000

# Poner en true solo si la base exige SSL (por ejemplo al usar la URL publica de Railway desde tu computador)
DB_SSL=false
